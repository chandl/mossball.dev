---
const items = [
  {
    title: 'Design',
    body: 'Interfaces with personality, designed together with the code that runs them.',
    bg: 'var(--moss-tint)',
    icon: 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z',
  },
  {
    title: 'Build',
    body: 'Fast, reliable apps for web and mobile, built to work well even offline.',
    bg: 'var(--sky)',
    icon: 'm8 8-4 4 4 4M16 8l4 4-4 4',
  },
  {
    title: 'Grow',
    body: 'We run and improve what we ship, for the long haul.',
    bg: 'var(--peach)',
    icon: 'M7 20h10M12 20V10M12 10c0-4-3-6-7-6 0 4 3 6 7 6zM12 12c0-3 2.5-5 6-5 0 3.5-2.5 5-6 5z',
  },
];
---

<section class="section">
  <div class="wrap">
    <header class="section-head reveal">
      <span class="label"><i>2</i>What we do</span>
      <h2 class="section-title serif">From the first sketch <em>to the server.</em></h2>
    </header>
    <div class="cols">
      {
        items.map((it) => (
          <div class="col reveal" style={`background:${it.bg}`}>
            <div class="ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={it.icon} />
              </svg>
            </div>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .col {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px;
    border-radius: 28px;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .ic svg {
    width: 22px;
    height: 22px;
    color: var(--moss);
  }
  h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  p {
    color: var(--ink-2);
  }
  @media (max-width: 880px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
