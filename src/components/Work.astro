---
const items = [
  { title: 'Design', body: 'Interfaces with personality, designed alongside the code that powers them.' },
  { title: 'Build', body: 'Thoughtful web and mobile software, built with reliability and real-world use in mind.' },
  { title: 'Grow', body: 'We operate, maintain, and improve the products we ship.' },
];
---

<section class="section work">
  <div class="wrap">
    <header>
      <p class="marker"><b>§ 02</b> How we work</p>
      <h2>From the first sketch <em>to the server.</em></h2>
      <p class="intro">One small studio does all of it, so the person drawing the screen is the one keeping it running.</p>
    </header>
    <ol>
      {
        items.map((it, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .work {
    background: var(--paper-alt);
  }
  .wrap {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 96px);
  }
  header {
    display: grid;
    gap: var(--s2);
    align-content: start;
  }
  h2 {
    font-size: clamp(32px, 3.8vw, 46px);
  }
  .intro {
    max-width: 34ch;
    color: var(--ink-2);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  li {
    display: grid;
    grid-template-columns: 48px 160px 1fr;
    gap: var(--s3);
    align-items: baseline;
    padding-block: var(--s4);
    border-top: 1px solid var(--rule-strong);
  }
  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--moss);
  }
  h3 {
    font-size: 30px;
  }
  li p {
    color: var(--ink-2);
  }
  @media (max-width: 880px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    li {
      grid-template-columns: 40px 1fr;
      gap: 6px var(--s2);
      padding-block: var(--s3);
    }
    li p {
      grid-column: 2;
    }
  }
</style>
