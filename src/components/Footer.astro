---
import Logo from './Logo.astro';
import { company } from '../data/company';
---

<footer>
  <div class="wrap">
    <Logo />
    <nav aria-label="Footer">
      <a href="/privacy">Privacy</a>
      <a href={`mailto:${company.email}`}>Contact</a>
      <span>© {company.founded} {company.legalName}</span>
    </nav>
  </div>
</footer>

<style>
  footer {
    padding-bottom: var(--s6);
    color: var(--muted);
    font-size: 14px;
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s2) var(--s4);
  }
  .wrap::before {
    content: '';
    flex-basis: 100%;
    height: var(--s3);
    border-top: 1px solid var(--ink);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
  }
  nav a {
    padding-block: 10px;
    margin-block: -10px;
  }
  a:hover {
    color: var(--ink);
  }
</style>
