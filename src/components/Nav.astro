---
import Logo from './Logo.astro';
import { company } from '../data/company';
---

<header>
  <div class="wrap">
    <div class="bar">
      <Logo />
      <p class="meta">Independent software · {company.location.replace('Washington', 'WA')}</p>
      <nav aria-label="Main">
        <a href="/#products">Products</a>
        <a href="/#about">About</a>
        <a href="/#hello">Contact</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s2);
    min-height: 76px;
    border-bottom: 1px solid var(--rule);
  }
  .meta {
    text-align: center;
  }
  nav {
    justify-self: end;
    display: flex;
    gap: var(--s3);
    font-size: 15px;
  }
  nav a {
    padding-block: 10px;
    color: var(--ink-2);
    text-decoration: underline 1px transparent;
    text-underline-offset: 6px;
  }
  nav a:hover {
    color: var(--ink);
    text-decoration-color: var(--moss);
  }
  @media (max-width: 880px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .meta {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0 var(--s2);
      padding-block: 10px 4px;
    }
    nav {
      gap: var(--s2);
      font-size: 14px;
    }
  }
</style>
