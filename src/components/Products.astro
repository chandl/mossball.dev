---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const [lead, ...rest] = products.map((p) => p.data);

const statusLabel = { live: 'Live', waitlist: 'Waitlist open', sprouting: 'In the works' } as const;
const host = (url: string) => new URL(url).host;
const no = (i: number) => String(i + 1).padStart(2, '0');
---

<section id="products" class="section">
  <div class="wrap">
    <header class="top">
      <p class="marker"><b>§ 01</b> Products</p>
      <h2>What we're <em>growing.</em></h2>
    </header>

    {
      lead && (
        <article class="lead" aria-labelledby="p-lead">
          <div class="text">
            <p class="meta id">
              <span>No. 01</span>
              {lead.glyph && <span lang="ja">{lead.glyph}</span>}
              <span class="dot">{statusLabel[lead.status]}</span>
            </p>
            <h3 id="p-lead">{lead.name}</h3>
            {lead.motto && <p class="motto">{lead.motto}</p>}
            <p class="desc">{lead.tagline}</p>
            {lead.features.length > 0 && (
              <dl>
                {lead.features.map((f) => (
                  <div>
                    <dt>{f.name}</dt>
                    <dd>{f.text}</dd>
                  </div>
                ))}
              </dl>
            )}
            {lead.url && (
              <a class="go" href={lead.url}>
                {lead.status === 'waitlist' ? 'Join the waitlist' : `Visit ${lead.name}`} at {host(lead.url)}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>

          {lead.shot && (
            <figure class="shot">
              <div class="frame">
                <Image src={lead.shot.src} alt={lead.shot.alt} widths={[390, 780]} sizes="(max-width: 880px) 92vw, 460px" />
              </div>
              <figcaption>
                <span class="meta">Fig. 2</span> {lead.shot.caption}
              </figcaption>
            </figure>
          )}
        </article>
      )
    }

    {
      rest.map((p, i) => (
        <article class="minor">
          <p class="meta">No. {no(i + 1)}</p>
          <h3>{p.name}</h3>
          <p class="desc">{p.tagline}</p>
          <p class="meta dot">{statusLabel[p.status]}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .top {
    display: grid;
    gap: var(--s2);
    margin-bottom: var(--s6);
  }
  h2 {
    font-size: clamp(36px, 4.6vw, 56px);
  }

  .lead {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
    padding-top: var(--s4);
    border-top: 1px solid var(--ink);
  }
  .id {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    align-items: baseline;
  }
  .id [lang='ja'] {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--ink-2);
  }
  .id .dot {
    color: var(--moss-dark);
  }
  .lead h3 {
    margin-top: var(--s3);
    font-size: clamp(56px, 7vw, 88px);
    font-weight: 400;
    line-height: 0.95;
  }
  .motto {
    margin-top: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(22px, 2.2vw, 28px);
    color: var(--moss);
  }
  .desc {
    max-width: 46ch;
    margin-top: var(--s3);
    color: var(--ink-2);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--s4);
    margin-block: var(--s4) var(--s3);
  }
  dl div {
    padding-block: 14px;
    border-top: 1px solid var(--rule);
  }
  dl div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  dt {
    font-weight: 600;
    font-size: 15px;
  }
  dd {
    margin-top: 2px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .frame {
    padding: clamp(16px, 3vw, 36px);
    background: var(--paper-alt);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .shot img {
    width: 100%;
    transition: transform 0.6s var(--ease);
  }
  .frame:hover img {
    transform: scale(1.015);
  }
  .shot figcaption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .shot figcaption .meta {
    margin-right: 6px;
    color: var(--moss);
  }

  .minor {
    display: grid;
    grid-template-columns: 1fr 3fr 5fr auto;
    gap: var(--s3);
    align-items: baseline;
    margin-top: var(--s8);
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }
  .minor h3 {
    font-size: 24px;
    color: var(--ink-2);
  }
  .minor .desc {
    margin: 0;
    font-size: 16px;
    color: var(--muted);
  }
  /* hollow dot: not yet live */
  .minor .dot::before {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--moss);
  }

  @media (max-width: 1000px) {
    dl {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 880px) {
    .lead {
      grid-template-columns: 1fr;
    }
    .shot {
      max-width: 520px;
    }
    .minor {
      grid-template-columns: 1fr;
      gap: var(--s1);
    }
  }
</style>
