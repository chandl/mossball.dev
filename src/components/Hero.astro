---
import { plateSvg } from '../scripts/mark';
---

<section class="hero">
  <div class="wrap">
    <div class="copy">
      <p class="kicker">Independent software studio</p>
      <h1>Good software,<br /> <em>grown in-house.</em></h1>
      <p class="lead">
        We design, build, and run our own software products. Small ideas, carefully made and improved over time.
      </p>
      <a class="go" href="#products">Explore our products <span aria-hidden="true">→</span></a>
    </div>

    <figure class="plate rise" aria-labelledby="plate-cap">
      <div class="head meta">
        <span>Pl. 001</span>
        <i>Aegagropila linnaei</i>
      </div>
      <div class="art">
        <Fragment set:html={plateSvg().replace('<svg ', '<svg aria-hidden="true" ')} />
        <canvas aria-hidden="true"></canvas>
        <p class="note meta">grows ~5&nbsp;mm<br />a year</p>
      </div>
      <figcaption id="plate-cap">
        <span class="meta">Fig. 1</span> Marimo, the slow-growing moss ball this studio is named after.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { mountOrb } from '../scripts/orb';
  // Reduced motion keeps the static SVG drawing.
  const art = document.querySelector<HTMLElement>('.plate .art');
  const canvas = art?.querySelector('canvas');
  if (art && canvas && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    mountOrb(canvas, () => art.classList.add('live'));
  }
</script>

<style>
  .hero {
    padding-block: clamp(48px, 7vw, 96px) var(--section);
  }
  .wrap {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--moss);
  }
  h1 {
    margin-block: var(--s3);
    font-size: clamp(46px, 7vw, 92px);
    font-weight: 380;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .lead {
    max-width: 40ch;
    margin-bottom: var(--s3);
    font-size: clamp(18px, 1.6vw, 20px);
    color: var(--ink-2);
  }

  .plate {
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
  }
  .head i {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--ink-2);
  }
  .art {
    position: relative;
  }
  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  .live canvas {
    display: block;
  }
  .live :global(.ball) {
    display: none;
  }
  /* sits at the end of the leader line drawn in plateSvg() */
  .note {
    position: absolute;
    right: 0;
    bottom: 71%;
    margin: 0 0 4px;
    text-align: right;
    color: var(--moss-dark);
  }
  figcaption {
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  figcaption .meta {
    margin-right: 6px;
    color: var(--moss);
  }

  @media (max-width: 880px) {
    .wrap {
      grid-template-columns: 1fr;
    }
    .plate {
      max-width: 420px;
    }
  }
  @media (max-width: 480px) {
    .plate {
      max-width: 320px;
    }
  }
</style>
