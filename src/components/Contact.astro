---
import { company } from '../data/company';
---

<section id="hello" class="section">
  <div class="wrap">
    <div class="hello">
      <div>
        <p class="marker"><b>§ 04</b> Contact</p>
        <h2>Say <em>hello.</em></h2>
      </div>
      <div class="body">
        <p>Questions, ideas, partnerships, or a bug you found. We read every message.</p>
        <a class="email" href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-top: 0;
  }
  .hello {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s3) clamp(32px, 6vw, 96px);
    align-items: end;
    padding-top: var(--s4);
    border-top: 1px solid var(--ink);
  }
  .hello > div:first-child {
    display: grid;
    gap: var(--s2);
  }
  h2 {
    font-size: clamp(40px, 5vw, 64px);
  }
  .body {
    display: grid;
    gap: var(--s2);
    justify-items: start;
  }
  .body p {
    max-width: 44ch;
    color: var(--ink-2);
  }
  .email {
    font-family: var(--serif);
    font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    color: var(--moss-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
    text-decoration-color: var(--sage);
  }
  .email:hover {
    color: var(--ink);
    text-decoration-color: var(--moss);
  }
  @media (max-width: 880px) {
    .hello {
      grid-template-columns: 1fr;
    }
  }
</style>
