---
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
---

<Base title={`Privacy — ${company.name}`} description={`Privacy policy for ${company.name}'s website.`}>
  <article class="wrap section">
    <p class="marker"><b>Last updated</b> October 2026</p>
    <h1>Privacy</h1>
    <p>
      This website (mossball.dev) doesn't use cookies, analytics or trackers, and it doesn't collect any personal
      information.
    </p>
    <p>
      The site is hosted on GitHub Pages. GitHub may log basic request data such as IP addresses to operate and secure
      its service; see the <a class="link" href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
        >GitHub Privacy Statement</a
      >.
    </p>
    <p>
      If you email us at <a class="link" href={`mailto:${company.email}`}>{company.email}</a>, we use your message and address only
      to reply, and we don't share them with anyone.
    </p>
    <p>Each of our products has its own privacy policy, published on that product's website.</p>
  </article>
</Base>

<style>
  article > * {
    max-width: 680px;
  }
  h1 {
    font-size: clamp(44px, 6vw, 72px);
    margin-block: var(--s2) var(--s4);
  }
  h1 ~ p {
    color: var(--ink-2);
  }
  h1 ~ p + p {
    margin-top: 16px;
  }
</style>
